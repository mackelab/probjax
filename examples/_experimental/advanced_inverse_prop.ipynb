    "env = Environment()\n",
    "eqn_env = EqnEnvironment(G, env, jaxpr.eqns, naive_cost_fn)\n",
    "\n",
    "map(env.write, jaxpr.jaxpr.constvars, jaxpr.consts)\n",
    "map(env.write, jaxpr.jaxpr.outvars, [y])\n",
    "\n",
    "\n",
    "G = construct_jaxpr_graph(jaxpr.jaxpr)"
   ]
