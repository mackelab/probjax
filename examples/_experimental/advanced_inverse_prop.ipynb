    "def f(x):\n",
    "    x = x.astype(jnp.float32)\n",
    "    return jax.lax.select_n(x >= 0, x*0.1, x)\n",
    "\n",
    "# def f(x):\n",
    "#     return jnp.where(x >= 0, x*0.1, x)\n",
    "x = jnp.array([-1., 0., 1.])\n",
    "y = f(x)\n",
    "jaxpr = jax.make_jaxpr(f)(jnp.array([-1, 0, 1]))\n",
    "g = JaxprGraph(jaxpr.jaxpr)\n",
    "\n",
    "g"
   ]
