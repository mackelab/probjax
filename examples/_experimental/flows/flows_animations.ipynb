   "source": [
    "import haiku as hk\n",
    "import jax\n",
    "import matplotlib.pyplot as plt\n",
    "import optax\n",
    "from jax import numpy as jnp\n",
    "from optax import adam\n",
    "\n",
    "from probjax.distributions import Normal\n",
    "from probjax.distributions.independent import Independent\n",
    "from probjax.distributions.transformed_distribution import TransformedDistribution\n",
    "from probjax.nn.bijective import rational_quadratic_spline\n",
    "from probjax.nn.coupling import CouplingMLP\n",
    "from probjax.nn.helpers import Flip"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 366,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "import numpy as np\n",
    "from IPython.display import HTML\n",
    "from matplotlib.animation import FuncAnimation\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "\n",
    "# Assuming you have y0, y1, y2, and y3 defined"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 367,
   "metadata": {},
   "outputs": [],
   "source": [
    "input_dim = 2\n",
    "p = Independent(Normal(jnp.zeros(input_dim), jnp.ones(input_dim)), 1)\n",
    "# Mixture of Gaussians target distribution\n",
    "\n",
    "target_samples1 = p.sample(jax.random.PRNGKey(0), (1000,)) + 5.0\n",
    "target_samples2 = p.sample(jax.random.PRNGKey(1), (1000,)) - 5.0\n",
    "xs = jnp.concatenate([target_samples1, target_samples2], axis=0)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 410,
   "metadata": {},
   "outputs": [],
   "source": [
    "input_dim = 2\n",
    "from functools import partial\n",
    "\n",
    "\n",
    "def additive_bijector(params, x):\n",
    "    scale, shift = jnp.split(params, 2, axis=-1)\n",
    "    scale = jnp.exp(scale) + 0.1\n",
    "    return x * scale + shift\n",
    "\n",
    "\n",
    "bijector_dim = 2\n",
    "hidden_dim = [50,50]\n",
    "@hk.without_apply_rng\n",
    "@hk.transform\n",
    "def forward(x):\n",
    "    nn = hk.Sequential([CouplingMLP(1, additive_bijector, bijector_dim, hidden_dims=hidden_dim),Flip(), CouplingMLP(1, additive_bijector, bijector_dim, hidden_dims=hidden_dim),Flip(), CouplingMLP(1, additive_bijector, bijector_dim, hidden_dims=hidden_dim)])\n",
    "    return nn(x)\n",
    "\n",
    "@hk.without_apply_rng\n",
    "@hk.transform\n",
    "def step_by_step_transform(x):\n",
    "    f1 = CouplingMLP(1, additive_bijector, bijector_dim, hidden_dims=hidden_dim)\n",
    "    f2 = Flip()\n",
    "    f3 = CouplingMLP(1, additive_bijector, bijector_dim, hidden_dims=hidden_dim)\n",
    "    f4 = Flip()\n",
    "    f5 = CouplingMLP(1, additive_bijector, bijector_dim, hidden_dims=hidden_dim)\n",
    "\n",
    "\n",
    "    y1 = f1(x)\n",
    "    y2 = f2(y1)\n",
    "    y3 = f3(y2)\n",
    "    y4 = f4(y3)\n",
    "    y5 = f5(y4)\n",
    "\n",
    "    return y1, y2, y3, y4, y5\n",
    "\n",
    "init, apply = forward.init, forward.apply\n",
    "params = init(jax.random.PRNGKey(0), jnp.ones((input_dim,)))\n",
    "T = apply\n",
    "T_steps = step_by_step_transform.apply"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 411,
   "metadata": {},
   "outputs": [],
   "source": [
    "y = apply(params, jnp.ones((input_dim)))\n",
    "\n",
    "q = TransformedDistribution(p, lambda x: T(params, x))\n",
    "samples = q.sample(jax.random.PRNGKey(0 ), (1000,))\n",
    "\n",
    "optimizer = adam(1e-3)\n",
    "opt_state = optimizer.init(params)\n",
    "\n",
    "# Train\n",
    "def loss_fn(params, x):\n",
    "    q = TransformedDistribution(p, lambda x: T(params, x))\n",
    "    return -q.log_prob(x).mean()\n",
    "\n",
    "@jax.jit\n",
    "def step(params, opt_state, x):\n",
    "    loss, g = jax.value_and_grad(loss_fn)(params, x)\n",
    "    updates, updated_state = optimizer.update(g, opt_state)\n",
    "    new_params = optax.apply_updates(params, updates)\n",
    "\n",
    "    return new_params, updated_state, loss"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 412,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
