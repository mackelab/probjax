   "source": [
    "%matplotlib inline\n",
    "fig, ax = plt.subplots(figsize=(8, 2))\n",
    "ax.set_yticks([])\n",
    "ax.set_xticks([])\n",
    "ax.set_ylim(-10, 10)\n",
    "ax.set_xlim(-10, 100)\n",
    "\n",
    "# Combine all data points into a single array\n",
    "all_data = [y1,y2, y3, y4, y5]\n",
    "\n",
    "# Define two colors for linear interpolation\n",
    "color1 = plt.rcParams['axes.prop_cycle'].by_key()['color'][0]\n",
    "color2 = plt.rcParams['axes.prop_cycle'].by_key()['color'][2]\n",
    "\n",
    "# Create a linear colormap\n",
    "linear_colormap = LinearSegmentedColormap.from_list('custom_colormap', [color1, color2], N=len(all_data))\n",
    "\n",
    "# Create an empty scatter plot with no data\n",
    "scatter1 = ax.scatter(y0[:,0], y0[:,1], alpha=0.1, color=color1, s=20)\n",
    "scatter2 = ax.scatter(90 + xs[:,0], xs[:,1], alpha=0.1, color=color2, s=20)\n",
    "\n",
    "offsets = [0,18, 36, 54, 72, 90]\n",
    "ax.vlines(offsets, -10, 10, color='black', alpha=0.5, linestyle='--')\n",
    "\n",
    "\n",
    "\n",
    "def update(frame):\n",
    "    # Update the positions and colors of the scatter points in each frame\n",
    "    if frame == 0:\n",
    "        return\n",
    "\n",
    "    frame = frame -1\n",
    "    current_data = all_data[frame]\n",
    "    current_color = linear_colormap((frame + 0.5)/3)\n",
    "    offset = offsets[1+frame]\n",
    "\n",
    "    ax.scatter(current_data[:,0] + offset, current_data[:,1], color=current_color, s=20, alpha=0.1)\n",
    "\n",
    "\n",
    "# Create an animation\n",
    "animation = FuncAnimation(fig, update, frames=6, interval=500, repeat=True)\n",
    "animation.save(\"flow_animation.gif\", writer=\"imagemagick\")"
   ]
  },
