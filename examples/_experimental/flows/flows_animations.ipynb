      "3.6576905\n"
     ]
    }
   ],
   "source": [
    "for i in range(7000):\n",
    "    xs_batch = jax.random.choice(jax.random.PRNGKey(i), xs, (1000,))\n",
    "    params, opt_state, loss = step(params, opt_state, xs_batch)\n",
    "    if i % 1000 == 0:\n",
    "        print(loss)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 413,
   "metadata": {},
   "outputs": [],
   "source": [
    "y0 = jax.random.normal(jax.random.PRNGKey(0), (500, input_dim))\n",
    "y1, y2, y3, y4, y5 = jax.vmap(T_steps,in_axes=(None, 0))(params,y0)"
   ]
  },
