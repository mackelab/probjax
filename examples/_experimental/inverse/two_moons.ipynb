   "source": [
    "thetas = jrandom.uniform(jrandom.PRNGKey(1), shape=(100000, 2), minval=-2., maxval=2.)\n",
    "xs = jnp.stack(jax.vmap(simulator_two_moons)(jrandom.split(jrandom.PRNGKey(2), 100000), thetas[:,0], thetas[:, 1]), axis=1)\n",
    "\n",
    "traces = jax.vmap(trace_simulator)(jrandom.split(jrandom.PRNGKey(2), 100000),  thetas[:,0], thetas[:, 1])"
   ]
