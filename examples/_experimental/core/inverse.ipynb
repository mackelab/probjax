    "\n",
    "from probjax.nn.coupling import CouplingMLP\n",
    "from probjax.nn.helpers import Permute\n",
    "\n",
    "\n",
    "@jax.vmap\n",
    "def affine_bijector(loc_and_scale, x):\n",
    "    loc, scale = jnp.split(loc_and_scale, 2, axis=-1)\n",
    "    scale = jnp.exp(scale) + 0.5\n",
    "    return loc + scale*x\n",
    "\n",
    "\n",
    "@hk.without_apply_rng\n",
    "@hk.transform\n",
    "def f(x):\n",
    "    #model = hk.Sequential([MaskedCoupling(mask, affine_transfomer, 4),\n",
    "    #                       MaskedCoupling(~mask, affine_transfomer, 4)])\n",
    "    model = hk.Sequential([Permute(jnp.array([0,2,1,3])), CouplingMLP(2, affine_transfomer, 4), Permute(jnp.array([0,2,1,3])) ])\n",
    "    return model(x)"
   ]
