    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "26000\n"
     ]
    }
   ],
   "source": [
    "print(total_number_steps)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "replicated_params = jax.tree_map(lambda x: jnp.array([x] * num_devices), params)\n",
    "replicated_opt_state = jax.tree_map(lambda x: jnp.array([x] * num_devices), opt_state)"
   ]
  },
