   "source": [
    "from functools import partial\n",
    "\n",
    "import haiku as hk\n",
    "import jax\n",
    "import jax.numpy as jnp\n",
    "import matplotlib.pyplot as plt\n",
    "import optax\n",
    "\n",
    "from probjax.nn.helpers import GaussianFourierEmbedding\n",
    "from probjax.nn.loss_fn import denoising_score_matching_loss"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[cuda(id=0)]"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "jax.devices()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sbibm import get_task\n",
    "\n",
    "task = get_task(\"two_moons\")\n",
    "prior = task.get_prior_dist()\n",
    "simulator = task.get_simulator()\n",
    "\n",
    "thetas = prior.sample((100000,))\n",
    "xs = simulator(thetas)\n",
    "\n",
    "thetas = jnp.array(thetas)\n",
    "xs = jnp.array(xs)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "data = jnp.hstack([thetas, xs])\n",
    "theta_dim = thetas.shape[-1]\n",
    "x_dim = xs.shape[-1]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "from probjax.distributions import Independent\n",
    "from probjax.distributions.discrete import Empirical\n",
    "from probjax.distributions.sde import VPSDE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "p0 = Independent(Empirical(data), 1)\n",
    "beta_max = 10.\n",
    "beta_min = 0.01\n",
    "sde = VPSDE(p0, beta_max=beta_max, beta_min=beta_min)\n",
    "t = jnp.linspace(0,1,200)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "mean_data = p0.mean\n",
    "\n",
    "def output_scale_fn(t, x):\n",
    "    scale = jnp.sqrt(jnp.sum(sde.marginal_variance(t[..., None], x0=jnp.ones_like(x)), -1))\n",
    "    return jnp.clip(1/scale[..., None],a_min=0.01, a_max=100.) * x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "def naive_mlp(output_dim:int, hidden_dim:int = 100, num_hidden:int=6, activation=jax.nn.gelu, layer_norm:bool = True):\n",
    "\n",
    "    def score_net(t, x, context):\n",
    "\n",
    "        x, context = jnp.broadcast_arrays(x, context)\n",
    "        x = jnp.concatenate([x, context], axis=-1)\n",
    "\n",
    "        time_embedding = GaussianFourierEmbedding(hidden_dim)(t[...,None])\n",
    "        h = activation(hk.Linear(hidden_dim)(x) + time_embedding)\n",
    "\n",
    "\n",
    "        for _ in range(num_hidden - 1):\n",
    "            h_new = hk.Linear(hidden_dim)(h)\n",
    "            h_new += time_embedding\n",
    "            h = activation(h_new)\n",
    "\n",
    "            if layer_norm:\n",
    "                h = hk.LayerNorm(axis=-1, create_scale=True, create_offset=True)(h)\n",
    "\n",
    "        out = hk.Linear(output_dim)(h)\n",
    "        out = output_scale_fn(t, out)\n",
    "        return out\n",
    "\n",
    "    init_fn, apply_fn = hk.without_apply_rng(hk.transform(score_net))\n",
    "    return init_fn, apply_fn\n",
    "\n",
    "\n",
    "init_fn, model_fn = naive_mlp(output_dim=theta_dim)\n",
    "params = init_fn(jax.random.PRNGKey(42), jnp.ones((10,)), thetas[:10], xs[:10])\n",
    "out = model_fn(params, jnp.ones((10,)), thetas[:10], xs[:10])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# VPSDE\n",
    "T = 1.\n",
    "T_min = 1e-5\n",
    "\n",
    "def weight_fn(t):\n",
    "    t = t.reshape(-1, 1)\n",
    "    return 1-jnp.exp(-0.5 * (beta_max - beta_min) * t**2 - beta_min * t) + 1e-4\n",
    "\n",
    "# def weight_fn(t):\n",
    "#     return 1."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
   "source": [
    "def loss_fn(params, key, data):\n",
    "    thetas, xs = jnp.split(data, 2, axis=-1)\n",
    "    key_times, key_loss, key_condition = jax.random.split(key,3)\n",
    "    times = jax.random.uniform(key_times, (data.shape[0],), minval=T_min, maxval =1.)\n",
    "    loss = denoising_score_matching_loss(params, key_loss, times, thetas, None, xs, model_fn = model_fn, mean_fn = sde.marginal_mean, std_fn=sde.marginal_stddev, weight_fn=weight_fn, axis=-1)\n",
    "    return loss\n",
    "\n",
    "\n",
    "\n",
    "@partial(jax.pmap, axis_name=\"num_devices\")\n",
    "def update(params, opt_state, key, data):\n",
    "    loss, grads = jax.value_and_grad(loss_fn)(params, key, data)\n",
    "\n",
    "    loss = jax.lax.pmean(loss, axis_name=\"num_devices\")\n",
    "    grads = jax.lax.pmean(grads, axis_name=\"num_devices\")\n",
    "\n",
    "    updates, opt_state = optimizer.update(grads, opt_state, params=params)\n",
    "    params = optax.apply_updates(params, updates)\n",
    "    return loss, params, opt_state\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "num_epochs = 1000\n",
    "batch_size = 4000\n",
    "num_devices = jax.device_count()\n",
    "batch_size_per_device = batch_size // num_devices\n",
    "num_steps = data.shape[0] // batch_size + 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "total_number_steps = num_epochs * num_steps\n",
    "schedule = optax.linear_schedule(5e-4, 0., total_number_steps//2, total_number_steps//2)\n",
    "optimizer = optax.chain(optax.adaptive_grad_clip(5.), optax.adam(schedule))\n",
    "opt_state = optimizer.init(params)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
