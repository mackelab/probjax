   "outputs": [],
   "source": [
    "key = jax.random.PRNGKey(0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 174,
   "metadata": {},
   "outputs": [],
   "source": [
    "A = 1.1  # State transition coefficient\n",
    "H = 1.0   # Observation matrix\n",
    "Q = 0.1    # Process noise variance\n",
    "R = 0.01   # Measurement noise variance\n",
    "\n",
    "def log_likelihood_fn(x,y,t):\n",
    "    return jax.scipy.stats.norm.logpdf(y,H* x, R)\n",
    "\n",
    "def transition_fn(key,x,t):\n",
    "    return A*x + jnp.sqrt(Q)*jax.random.normal(key, shape=x.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 175,
   "metadata": {},
   "outputs": [],
   "source": [
    "def simulate(key, x0, ts):\n",
    "    x = jnp.asarray(x0)\n",
    "    xs = [x]\n",
    "    for t in ts[1:]:\n",
    "        key, subkey = jax.random.split(key)\n",
    "        x = transition_fn(subkey, x, t)\n",
    "        xs.append(x)\n",
    "\n",
    "    return jnp.stack(xs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 176,
   "metadata": {},
   "outputs": [],
   "source": [
    "num_time_points = 50\n",
    "ts = jnp.linspace(0, 50, num_time_points)\n",
    "xs = jax.vmap(simulate, in_axes=(0,None,None))(jax.random.split(key, 100), 0., ts)"
   ]
  },
