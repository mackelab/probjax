   "metadata": {},
   "outputs": [],
   "source": [
    "from probjax.inference.smc.resampling import resample_smoothed, resample_systematic"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "N = 1000\n",
    "particles = jax.random.normal(jax.random.PRNGKey(0), (N,1))\n",
    "weights = jax.scipy.stats.norm.pdf(particles, loc=0.0, scale=0.1).sum(axis=1)\n",
    "weights = weights / jnp.sum(weights)\n"
   ]
  },
