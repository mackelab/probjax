    "import blackjax\n",
    "import jax\n",
    "import jax.numpy as jnp\n",
    "\n",
    "# Set device to CPU\n",
    "jax.config.update(\"jax_platform_name\", \"cpu\")\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from probjax.inference.filtering.particle_filter import ParticleFilter"
   ]
